# Runtime secrets and deployment-only files (never commit)
.env
.env.*
!.env.example
*.env
!.env.example

# Local runtime data / logs, if ever bind-mounted into the working tree
data/
logs/
*.log

# Python
__pycache__/
*.py[cod]

# Agent scratch
.openclaw/

# Vendored upstream Traccar source (issue #11) is preserved byte-for-byte.
# Re-include the non-secret upstream files that the secret/runtime patterns
# above would otherwise drop (verified by scripts/check-deployment-artifacts.py).
!vendor/traccar-web/.env
!vendor/traccar-web/src/resources/images/data/
