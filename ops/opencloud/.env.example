# fleet-cloud-opencloud runtime configuration — TEMPLATE ONLY, no secrets.
#
# This file documents the variables the OpenCloud stack reads. Copy it to the
# deployment-only secrets file and fill in real values:
#
#   install -d -m 0750 /srv/fleet-cloud-opencloud
#   install -m 0600 /dev/null /srv/fleet-cloud-opencloud/.env   # root-owned
#   ${EDITOR:-vi} /srv/fleet-cloud-opencloud/.env
#
# Never commit the filled file, never paste its values into GitHub, Telegram,
# logs or prompts. Compose reads it with:
#   docker compose --env-file /srv/fleet-cloud-opencloud/.env \
#     -f ops/opencloud/compose.yaml up -d
#
# Generate the admin password with a password manager or:
#   openssl rand -base64 36

# --- Public HTTPS origin (TLS is terminated by Nginx/Cloudflare) ---
OPENCLOUD_URL=https://files.nazimlaw.com

# --- Initial password for the built-in `admin` user ---
# Mandatory. Set a unique long value here, sign in as `admin` once, then
# rotate it from the profile page. Never reuse a Fleet Cloud/Traccar secret.
OPENCLOUD_ADMIN_PASSWORD=replace-with-a-unique-long-random-password

# --- Logging level: debug | info | warn | error ---
OPENCLOUD_LOG_LEVEL=info
