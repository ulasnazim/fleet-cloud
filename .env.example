# fleet-cloud runtime configuration — TEMPLATE ONLY, contains no secrets.
#
# Copy this to the deployment-only secrets file and fill in real values:
#
#   install -d -m 0750 /srv/fleet-cloud
#   install -m 0600 /dev/null /srv/fleet-cloud/.env   # root-owned
#   ${EDITOR:-vi} /srv/fleet-cloud/.env
#
# Never commit the filled file. Compose reads it with:
#   docker compose --env-file /srv/fleet-cloud/.env up -d
#
# Generate the passwords with a password manager or:
#   openssl rand -base64 36

# --- MySQL 8 (compose service: database) ---
MYSQL_DATABASE=traccar
MYSQL_USER=traccar
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# --- Traccar (compose service: traccar) ---
# Public HTTPS origin used for CORS; TLS is terminated by Nginx.
TRACCAR_WEB_ORIGIN=https://fleet.nazimlaw.com
# Logging level: off | severe | warning | info | config | fine | finer | finest | all
TRACCAR_LOGGER_LEVEL=info
# Authentication session timeout in seconds.
TRACCAR_WEB_SESSION_TIMEOUT=3600
